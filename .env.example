NEXT_PUBLIC_SUPABASE_URL=https://wavwoupjwulepbifzvkz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key
# Never add service_role or sb_secret keys to NEXT_PUBLIC variables or commit them.
# Google Drive OAuth — server-only secrets; never use NEXT_PUBLIC_ for these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-drive/callback
GOOGLE_OAUTH_STATE_SECRET=
# Base64-encoded 32 random bytes for AES-256-GCM refresh-token encryption.
GOOGLE_TOKEN_ENCRYPTION_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public values used only by the Google Picker UI.
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# Candidate registration and email OTP. Keep both false until Supabase Auth,
# CAPTCHA, durable rate limiting, and a transactional email provider are tested.
REGISTRATION_ENABLED=false
AUTH_OTP_ENABLED=false

# Server-only encryption key for the optional Employee ID. Generate using:
# openssl rand -base64 32
EMPLOYEE_ID_ENCRYPTION_KEY=

# Server-only organization identifier. Never expose through NEXT_PUBLIC_.
BRS_ORGANIZATION_ID=4a7133e1-dc9d-46d0-b503-b51aaba28251
